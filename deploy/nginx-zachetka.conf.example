# Добавьте эти директивы внутрь server { ... } своего Nginx.
# Важно: 25m ограничивает общий HTTP-запрос, а Django отклоняет файл >20 МиБ.
# Так запросы на 21 МиБ получают понятную ошибку именно от Django.
client_max_body_size 25m;

# Не публикуем MEDIA_ROOT. Все доступные файлы выдаёт только Django,
# через /materials/<id>/file/ после проверки входа и флага Скрыт.
location /media/ {
    return 403;
}

# Если размер запроса превышает даже 25m, Nginx вернёт 413.
# Подключение к приложению и раздачу /static/ настройте по вашей схеме хостинга.
